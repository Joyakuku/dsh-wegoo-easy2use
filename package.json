{
  "name": "dsh-wegoo-easy2use",
  "version": "0.1.0",
  "description": "wegoo relay for DeepSeek Harness: image/video generation tools with a local cost ledger and budget guards",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.png",
    "icon.svg",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wegoo",
    "image",
    "video",
    "cost"
  ],
  "license": "MIT"
}
