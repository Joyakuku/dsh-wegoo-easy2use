{
  "name": "dsh-wegoo-easy2use",
  "version": "0.2.1",
  "icon": "./icon.svg",
  "description": "wegoo relay for DeepSeek Harness: image/video generation tools with a local cost ledger and budget guards",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.png",
    "icon.svg",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "docs",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wegoo",
    "image",
    "video",
    "cost"
  ],
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "test": "node test/smoke.mjs && node test/host.mjs && node test/client.mjs"
  }
}
